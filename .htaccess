Options -MultiViews
RewriteEngine On
RewriteBase /

# Canonical route redirects for Apache deployments
RewriteRule ^home/?$ / [R=301,L,NC]
RewriteRule ^about/?$ /about-us [R=301,L,NC]
RewriteRule ^contact/?$ /contact-us [R=301,L,NC]
RewriteRule ^career/?$ /careers [R=301,L,NC]
RewriteRule ^login/?$ /sign-in [R=301,L,NC]

RewriteRule ^solutions/sms/?$ /sms [R=301,L,NC]
RewriteRule ^solutions/data/?$ /data [R=301,L,NC]
RewriteRule ^solutions/payment/?$ /payment [R=301,L,NC]
RewriteRule ^solutions/ussd/?$ /ussd [R=301,L,NC]
RewriteRule ^solutions/shortcode/?$ /shortcode [R=301,L,NC]
RewriteRule ^solutions/voice/?$ /voice [R=301,L,NC]
RewriteRule ^solutions/crbt/?$ /call-back [R=301,L,NC]
RewriteRule ^solutions/airtime/?$ /airtime [R=301,L,NC]

# Serve files from build/client if they exist
RewriteCond %{DOCUMENT_ROOT}/build/client%{REQUEST_URI} -f
RewriteRule ^ build/client%{REQUEST_URI} [L]

# Serve directories from build/client if they exist
RewriteCond %{DOCUMENT_ROOT}/build/client%{REQUEST_URI} -d
RewriteRule ^ build/client%{REQUEST_URI} [L]

# Fallback to build/client/index.html for SPA routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ build/client/index.html [L]

<IfModule mod_headers.c>
    <FilesMatch "\.(css)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, OPTIONS"
        Header set Vary "Origin"
    </FilesMatch>
</IfModule>

AddType text/css .css
